	<!-- chat bubble component -->


<div class="flex @(IsCurrentUser ? "flex-col items-end" : "items-start space-x-2")">
	@if (!IsCurrentUser && friend != null)
	{
		<NavLink href="@($"/profile/{friend.UserId}")" class="min-fit">
			<UserImageComponent Src="@(string.IsNullOrEmpty(friend.PhotoPath) ? friend.UserName.Substring(0, 2).ToUpper() : friend.PhotoPath)" />
		</NavLink>
	}

	@if (message != null)
	{
		<div class="chat-bubble @(IsCurrentUser ? "chat-bubble-right" : "chat-bubble-left")">
			<p>@message.Content</p>
			<!-- Message status indicators -->
			<div class="message-status">
				@if (IsCurrentUser)
				{
					@if (message.SeenBy.Count > 0)
					{
						<i class="fas fa-check-double text-cyan-400"></i>
					}
					else if (message.IsDelivered)
					{
						<i class="fas fa-check-double text-gray-400"></i>
					}
					else
					{
						<i class="fas fa-check text-gray-400"></i>
					}
				}
			</div>
		</div>
		<small class="message-timestamp ml-2">
			@(message.DateSentUTC.ToLocalTime().Minute == LastMessageDateUtc.ToLocalTime().Minute ? "" : message.DateSentUTC.ToLocalTime().ToString("hh:mm tt"))
		</small>
	}
</div>

@code {
	[Parameter]
	public bool IsCurrentUser { get; set; } = true;

	[Parameter]
	public User? friend { get; set; }

	[Parameter]
	public Message? message { get; set; }

	[Parameter]
	public DateTime LastMessageDateUtc { get; set; }
}
