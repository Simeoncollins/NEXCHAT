@if (Src.Length > 2)
{
	<div class="relative min-fit">
		<img src="@Src" alt="Profile" class="w-10 h-10 rounded-full border-2 border-white">
		@if (UserStatus == StatusType.Online){
			<span class="absolute w-3 h-3 rounded-full bottom-0 right-0 border-2" style="background-color: #1edf1e;"></span>
		}
	</div>
}
else if (Src.Length == 2)
{
	<div class="relative min-fit">
		<div class="rounded-full w-10 h-10 flex items-center justify-center text-white border-2" style="background: linear-gradient(45deg, #00f7ff, #e100ff);">
			<span>@Src</span>
		</div>
		@if (UserStatus == StatusType.Online)
		{
			<span class="absolute w-3 h-3 rounded-full bottom-0 right-0 border-2" style="background-color: #1edf1e;"></span>
		}
	</div>
}

else
{
<div class="rounded-full w-10 h-10 bg-gray-300 flex items-center justify-center text-gray-700 min-fit">
	<span>?</span>
</div>
}


@code {
	[Parameter]
	public string Src { get; set; } = "";

	[Parameter]
	public StatusType UserStatus { get; set; } = StatusType.Offline;
}
