@page "/groups"
@attribute [Authorize]
<PageTitle>Groups - NEXCHAT</PageTitle>

<main class="flex-grow flex items-center justify-center pt-6 pb-24 h-[80vh]" style="margin-top: 80px;" data-aos="fade-in">
    <div class="text-center max-w-lg w-full mx-4">
        <div class="w-24 h-24 mx-auto bg-cyan-500/20 rounded-full flex items-center justify-center mb-6 shadow-[0_0_15px_rgba(6,182,212,0.3)]">
            <i class="fas fa-users text-4xl text-cyan-400"></i>
        </div>
        <h2 class="text-3xl font-extrabold text-white mb-3">Groups</h2>
        <p class="text-gray-400 text-sm leading-relaxed mb-8">This feature is planned for a future update in this project. Feel free to explore the repository or contribute!</p>
        <a style="cursor:pointer;" href="https://github.com/Simeoncollins/NEXCHAT" target="_blank" class="inline-block px-5 py-2.5 bg-purple-500/10 text-purple-400 rounded-full text-xs font-bold uppercase tracking-widest border border-purple-500/20">
            <i class="fab fa-github mr-2"></i> In Development
        </a>
    </div>
</main>
