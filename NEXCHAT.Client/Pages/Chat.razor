@page "/chat/{friendId:guid}"
@layout Layout.AuthLayout
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http
@attribute [Authorize]
@inject IJSRuntime JSRuntime
@inject ChatSignalRService ChatService
@inject IToastService ToastService

<PageTitle>Chat-@friendName</PageTitle>
<div class="flex items-center space-x-4 py-4 px-8 border-b border-white/10 fixed w-full top-0 backdrop-blur-lg chatHeader" style="z-index:99">
	<!-- Back Button -->
	<button class="text-white hover:text-cyan-400 transition-colors text-2xl focus:outline-none"
			onclick="window.history.back()">
		<i class="fas fa-arrow-left"></i>
	</button>
	@if (isFriendLoading)
	{
		<FriendConversationImageLoading />
	}
	else if (!isFriendLoading && friend != null)
	{
		<NavLink href="@($"/profile/{friend.UserId}")" class="min-fit">
			<UserImageComponent Src="@(string.IsNullOrEmpty(friend.PhotoPath) ? friend.UserName.Substring(0, 2).ToUpper() : friend.PhotoPath)"
			UserStatus="friend.Status" />
		</NavLink>

		<div>
			<NavLink href="@($"/profile/{friend.UserId}")" class="font-bold text-xl hover:underline">
				@friend.UserName
			</NavLink>
			<p class="text-gray-400 text-sm">@friend.Email</p>
		</div>
	}
</div>

<main class="flex-grow pb-4" style="margin-top: 82px;">
	<div class="container mx-auto px-4 py-2">
		@if (isConvLoading)
		{
			<ConversationLoadingComponent />
		}
		@if (!isConvLoading && user != null && friend != null)
		{

			if (conversation == null)
			{
				<div class="chat-date">
					@DateTime.Now.ToString("MMM dd yyyy")
				</div>
			}

			<!-- Chat Messages Container -->
			<div class="space-y-4 mb-16" @ref="messagesContainer">
				@if (messages?.Count > 0)
				{
					<Virtualize Items="messages" Context="msg" @ref="virtualizeContainer">
						@{
							// Calculate if this message needs a date header
							var currentIndex = messages.IndexOf(msg);
							var isNewDay = currentIndex == 0 ||
					msg.DateSentUTC.Date != messages[currentIndex - 1].DateSentUTC.Date;
						}

						@if (isNewDay)
						{
							<div class="chat-date text-center my-4">
								@msg.DateSentUTC.ToLocalTime().ToString("MMM dd yyyy")
							</div>
						}

						<ChatBubbleComponent Message="msg"
						IsCurrentUser="msg.SenderId == user.UserId"
						Friend="friend" />
					</Virtualize>
					if(conversation.ParticipantsTyping.Any())
					{
						<TypingIndicatorComponent UserId="user.UserId" TypingUsers="conversation.ParticipantsTyping" />
					}
				}
				else
				{
					<div class="text-center py-10 text-gray-500">
						No messages yet. Start the conversation!
					</div>
				}

			</div>
		}
	</div>
</main>

<div class="fixed bottom-0 w-full bg-black/80 backdrop-blur-lg border-t border-white/10">
	<div class="container mx-auto px-4 py-3">
		<div class="flex items-end space-x-2">
			<textarea value="@message" @oninput="@((e) => OnInputChanged(e))"
			placeholder="Send a message..."
			class="messageTxt flex-grow bg-black/30 border border-cyan-400/20 rounded-lg px-4 py-2 text-white focus:border-cyan-400 focus:outline-none"></textarea>

			<button class="text-white hover:text-cyan-400 transition-colors" @onclick="sendMessage">
				<i class="fas fa-paper-plane text-xl"></i>
			</button>
		</div>
	</div>
</div>


@code {
	[Parameter]
	public Guid friendId { get; set; }

	private User? user;
	private User? friend;
	private Conversation? conversation;
	private List<Message>? messages = new();
	public string friendName = "friend";
	private bool isFriendLoading = true;
	private bool isConvLoading = true;
	private bool isUserBlocked = false;


	private int pageIndex = 1;
	private int pageSize = 30;

	private Virtualize<Message> virtualizeContainer;
	private string message = "";
	Guid conversationId = Guid.Empty;

	private ElementReference messagesContainer;
	private bool shouldScrollToBottom = true;

	private bool messagesMarked = false;

	private readonly object typingLock = new object();
	private Timer? _typingCleanupTimer;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (shouldScrollToBottom)
		{
			await ScrollToBottom();
			shouldScrollToBottom = false;
		}
	}

	private async Task OnInputChanged(ChangeEventArgs e)
	{
		message = e.Value?.ToString() ?? "";

		if (conversation == null) return;

		if (message.Length > 0)
		{
			await Http.PostAsync($"api/conversations/{conversationId}/typing-indicator?userId={user.UserId}&isTyping=true", null);
		}
		else if (message.Length == 0)
		{
			await Http.PostAsync($"api/conversations/{conversationId}/typing-indicator?userId={user.UserId}&isTyping=false", null);
		}
	}
	private async Task sendMessage()
	{
		if (!string.IsNullOrEmpty(message))
		{
			if (user == null || friend == null) return;

			bool isDelivered = friend.Status == StatusType.Online ? true : false;
			Guid messageId = Guid.NewGuid();
			DateTime date = DateTime.UtcNow;
			
			Message newMessage = new Message
				{
					MessageId = messageId,
					Content = message,
					ConversationId = conversationId,
					SenderId = user.UserId,
					DateSentUTC = date,
					IsDelivered = isDelivered
				};

			messages.Add(newMessage);
			message = "";
			shouldScrollToBottom = true;
			StateHasChanged();
			try
			{
				if (conversation == null)
				{

					StartConversationRequestDto convDto = new()
						{
							CreatorId = user.UserId,
							ConversationdId = conversationId,
							Participants = new List<Guid> { user.UserId, friend.UserId },
							IsGroup = false,
							GroupName = string.Empty,
							Message = newMessage
						};

					var content = JsonContent.Create(convDto);
					var response = await Http.PostAsync("api/conversations/start", content);

					if (response.IsSuccessStatusCode)
					{
						conversationId = await response.Content.ReadFromJsonAsync<Guid>();
					}
					else
					{
						var error = await response.Content.ReadAsStringAsync();
						Console.WriteLine($"Error: {response.StatusCode}, {error}");
					}

				}
				else{
					var dto = JsonContent.Create(newMessage);
					await Http.PostAsync("api/messages/send", dto);
				}
			}


			catch
			{
				// Handle error
				messages.Remove(newMessage);
				message = newMessage.Content;
				StateHasChanged();
			}
		}
	}

	protected async override Task OnInitializedAsync()
	{
		var auth = await AuthStateProvider.GetAuthenticationStateAsync();
		var userIdClaim = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
		if (!Guid.TryParse(userIdClaim, out var userId))
		{
			isFriendLoading = false;
			isConvLoading = false;
			return;
		}

		try
		{
			user = await Http.GetFromJsonAsync<User>($"api/users/{userId}/basic");
			friend = await Http.GetFromJsonAsync<User>($"api/users/{friendId}/basic");
		}
		catch
		{
			user = null;
			friend = null;
		}
		await LoadMore();
		await InitializeSignalR();
	}
	private async Task markNewMessagesAsSeen()
	{
		var response = await Http.PutAsync($"api/messages/conversation/{conversationId}/seen?userId={user.UserId}", null);
	}
	private async Task LoadMore()
	{
		if (user != null && friend != null)
		{
			isFriendLoading = false;
			try
			{
				conversationId = GuidCombiner.CombineGuids(user.UserId, friend.UserId);
				var response = await Http.GetAsync($"api/conversations/{conversationId}");
				if (response.IsSuccessStatusCode)
				{
					conversation = await response.Content.ReadFromJsonAsync<Conversation>();
				}
				else if (response.StatusCode == HttpStatusCode.NotFound)
				{
					conversation = null;
				}
				else
				{
					ToastService.ShowToast(ToastType.Danger, "Error", "Failed to get conversation.");
				}
				if (conversation != null)
				{
					var url = $"api/messages/conversation?conversationId={conversationId}&pageIndex={pageIndex}&pageSize={pageSize}";
					var newMessages = await Http.GetFromJsonAsync<List<Message>>(url);
					if (newMessages != null)
					{
						messages?.AddRange(newMessages);
					}
					if (!messagesMarked)
					{
						await markNewMessagesAsSeen();
						messagesMarked = true;
					}
				}
			}
			catch (Exception ex)
			{
				Console.WriteLine(ex.StackTrace);
				ToastService.ShowToast(ToastType.Danger, "Error!", "Error getting conversation");
			}
			finally
			{
				isConvLoading = false;
			}
		}
	}

	private async Task ScrollToBottom()
	{
		await JSRuntime.InvokeVoidAsync("scrollToBottom", messagesContainer);
	}

	private async Task InitializeSignalR()
	{
		if (user == null) return;

		// Connect to SignalR
		await ChatService.ConnectAsync(user.UserId);

		// Subscribe to message events
		ChatService.OnMessageReceived += HandleNewMessage;
		ChatService.OnMessageDelivered += HandleMessageDelivery;
		ChatService.OnMessageSeen += HandleMessageSeen;
		ChatService.OnUserStatusChanged += HandleStatusChange;
		ChatService.OnTypingUsers += HandleTypingUsersChanged;
	}
	private void HandleTypingUsersChanged(UserTyping userTyping)
	{
		if (conversationId != userTyping.ConversationId) return;
		
		lock (typingLock)
		{
			if (userTyping.IsTyping)
			{
				// Add or update typing user
				var existing = conversation.ParticipantsTyping.FirstOrDefault(u => u.UserId == userTyping.UserId);
				if (existing == null)
				{
					conversation.ParticipantsTyping.Add(new ConversationTypingUser
						{
							UserId = userTyping.UserId,
							Name = userTyping.Name,
							PhotoPath = userTyping.PhotoPath,
							ConversationId = conversation.ConversationId,
							LastTypingTime = DateTime.UtcNow
						});
				}
				else
				{
					existing.LastTypingTime = DateTime.UtcNow;
				}
			}
			else
			{
				// Remove user from typing list
				var userToRemove = conversation.ParticipantsTyping.FirstOrDefault(u => u.UserId == userTyping.UserId);
				if (userToRemove != null)
				{
					conversation.ParticipantsTyping.Remove(userToRemove);
				}
			}
		}

		StartTypingCleanupTimer();
		StateHasChanged();
	}

	private void StartTypingCleanupTimer()
	{
		// Clear typing indicators after 5 seconds of inactivity
		_typingCleanupTimer?.Dispose();
		_typingCleanupTimer = new Timer(_ =>
		{
			lock (typingLock)
			{
				var cutoff = DateTime.UtcNow.AddSeconds(-5);
				conversation.ParticipantsTyping.RemoveAll(u => u.LastTypingTime < cutoff);
			}
			InvokeAsync(StateHasChanged);
		}, null, 5000, Timeout.Infinite);
	}
	private void HandleStatusChange(UserStatus userStatus)
	{
		if(friendId == userStatus.UserId)
		{
			friend.Status = userStatus.Status;
			StateHasChanged();
		}
	}
	private void HandleNewMessage(Message message)
	{
		// Only process messages for current conversation
		if (message.ConversationId == conversationId)
		{
			// Update message status if it's from current user (optimistic update)
			if (message.SenderId == user.UserId)
			{
				message.IsDelivered = true;
			}

			messages.Add(message);
			shouldScrollToBottom = true;
			StateHasChanged();

			playRecievedMessageSound();
		}
	}

	private void HandleMessageDelivery(Guid convId)
	{
		if (convId == conversationId)
		{
			// Update delivery status for sent messages
			foreach (var msg in messages.Where(m =>
				m.SenderId == user.UserId &&
				!m.IsDelivered))
			{
				msg.IsDelivered = true;
			}
		}
		StateHasChanged();
	}

	private void HandleMessageSeen(MessageSeen seen)
	{
		// Update seen status for sent messages
		foreach (var msg in messages.Where(m =>
			m.SenderId == user.UserId &&
			m.IsDelivered))
		{
			msg.SeenBy.Add(seen);
		}
		StateHasChanged();
	}

	private void playRecievedMessageSound()
	{
		// play sound
	}

}
