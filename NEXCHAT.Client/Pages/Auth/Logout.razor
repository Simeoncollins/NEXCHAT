@page "/auth/logout/{userId:guid}"
@inject AuthenticationStateProvider AuthStateProvider
@inject TokenService TokenSvc
@inject NavigationManager Nav
@inject HttpClient Http


@code {
    [Parameter]
    public Guid userId { get; set; }
    protected override async Task OnInitializedAsync()
    {
        var content = JsonContent.Create(new UpdateUserStatusDto { UserId = userId, StatusType = StatusType.Offline });
        var response = await Http.PutAsync($"api/users/status", content);
        // 1) Clear tokens
        await TokenSvc.RemoveAsync();

        // 2) Notify auth provider of anonymous user
        if (AuthStateProvider is JwtAuthStateProvider jwtProv)
        {
            jwtProv.NotifyUserLogout();
        }

        // 3) Redirect to login
        Nav.NavigateTo("/auth/login", true);
    }
}
