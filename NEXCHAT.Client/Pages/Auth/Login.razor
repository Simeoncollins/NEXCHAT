@page "/auth/login"
@using Shared.DTOS
@inject HttpClient Http
@inject TokenService TokenSvc
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@layout Layout.AuthLayout

<main class="min-h-screen flex items-center justify-center px-4 authPage">
    <div class="w-full max-w-md bg-black/50 backdrop-blur-sm p-8 rounded-lg shadow-lg">
        <div class="mb-8 text-center">
            <NavLink href="/" class="logo inline-flex items-center space-x-2">
                <div class="relative w-12 h-12">
                    <div class="absolute inset-0 bg-cyan-500 blur-xl opacity-70"></div>
                    <svg class="text-cyan-400 w-12 h-12" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10" />
                    </svg>
                </div>
                <span class="text-3xl font-bold text-gradient font-orbitron">NEXCHAT</span>
            </NavLink>
            <h2 class="mt-4 text-2xl font-bold text-white">Login</h2>
        </div>
        <!-- Login Form -->
        <EditForm Model="credentials" class="space-y-6" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />
            <div>
                <label for="username" class="block text-sm font-medium text-gray-300 mb-1">Email or Username</label>
                <InputText @bind-Value="credentials.Username" class="input-field w-full" id="username" placeholder="Email address or username" />
                <ValidationMessage For="() => credentials.Username" class="text-sm text-red-500"></ValidationMessage>
            </div>
            <div>
                <label for="password" class="block text-sm font-medium text-gray-300 mb-1">Password</label>
                <InputText @bind-Value="credentials.Password" type="password" class="input-field w-full" id="password" placeholder="Password" />
                <ValidationMessage For="() => credentials.Password" class="text-sm text-red-500"></ValidationMessage>
            </div>

            <div>
                <button type="submit" class="btn-login w-full" disabled="@isSubmitting">
                    @(isSubmitting ? "Logging in…" : "Login")
                </button>
            </div>
        </EditForm>
        <!-- Signup Link -->
        <p class="mt-6 text-center text-sm text-gray-300">
            Don't have an account?
            <NavLink class="link-signup font-bold" href="/auth/signup">
                Sign Up
            </NavLink>
        </p>
    </div>
</main>
<ToastComponent @ref="toastComponent" Timeout="3000" />

@code {
    private LoginDto credentials = new();
    private bool isSubmitting;
    private string? errorMessage;
    [Parameter]
    [SupplyParameterFromQuery(Name = "registered")]
    public bool Registered { get; set; }

    private ToastComponent? toastComponent;
    private bool hasShownRegisteredToast;

    protected override void OnInitialized()
    {
        // Flag that we need to show it
        hasShownRegisteredToast = Registered;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && hasShownRegisteredToast)
        {
            toastComponent?.ShowToast(
                ToastType.Success,
                "Success!",
                "Account created successfully. You can now log in."
            );

            hasShownRegisteredToast = false; // only once
        }
    }
    private async Task HandleLogin()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", credentials);
            if (response.IsSuccessStatusCode)
            {
                var tokens = await response.Content.ReadFromJsonAsync<TokenResponseDto>();
                if (tokens is null)
                {
                    errorMessage = "Invalid response from server.";
                }
                else
                {
                    // Persist tokens (localStorage)
                    await TokenSvc.SaveAsync(tokens);

                    // Notify the auth state provider to re-read the JWT
                    if (AuthStateProvider is JwtAuthStateProvider jwtProv)
                    {
                        jwtProv.NotifyUserAuthentication(tokens.AccessToken);
                    }

                    Nav.NavigateTo("/dashboard");
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "Invalid username or password.";
            }
            else
            {
                errorMessage = "Login failed. Try again later.";
            }
            if (!string.IsNullOrEmpty(errorMessage))
            {
                toastComponent?.ShowToast(ToastType.Danger, "Error!", errorMessage);
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
