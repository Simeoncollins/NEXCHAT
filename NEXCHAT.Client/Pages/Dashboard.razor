@page "/dashboard"
@using NEXCHAT.CoreBusiness.Classes
@inject AuthenticationStateProvider AuthStateProvider
@inject IToastService ToastService
@inject TokenService TokenSvc
@inject NavigationManager Nav
@inject HttpClient Http
@attribute [Authorize]


<h3>Welcome, @user?.UserName!</h3>

@if (isLoading)
{
    <p><em>Loading your profile…</em></p>
}
else if (user == null)
{
    <p class="text-danger">Unable to load user details. Please <a @onclick="RedirectToLogin">log in</a> again.</p>
}
else
{
    <div class="card" style="width: 18rem;">
        <img src="@user.PhotoPath" class="card-img-top" alt="Profile photo" />
        <div class="card-body">
            <h5 class="card-title">@user.FirstName @user.LastName</h5>
            <p class="card-text">
                <strong>Username:</strong> @user.UserName<br />
                <strong>Email:</strong> @user.Email<br />
                <strong>Status:</strong> @user.Status<br />
                <strong>Question:</strong> @user.SecurityQuestion<br />
                <strong>Answer:</strong> @user.SecurityAnswer<br />
                <strong>Date Joined:</strong> @user.DateJoined.ToLocalTime().ToString("MMMM dd, yyyy")
                <strong>Last Login:</strong> @user.LastLogin.ToLocalTime().ToString("MMMM dd, yyyy")
            </p>
            <p>guid1 + guid2 = @GuidCombiner.CombineGuids(guid1, guid2);</p>
            <p>guid2 + guid1 = @GuidCombiner.CombineGuids(guid2, guid1);</p>
            <button class="btn btn-danger" @onclick="Logout">Logout</button>
        </div>
    </div>
}

<button @onclick="ShowNotification">Show Toast</button>
<button @onclick="ShowNotification2">Show Toast With Url</button>

@code {
    private User? user;
    private bool isLoading = true;
    private Guid guid1 = Guid.Parse("2bb77c68-06f5-4e13-b0a2-a6bc61fabbf9");
    private Guid guid2 = Guid.Parse("11111111-1111-1111-1111-111111111111");

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!Guid.TryParse(userIdClaim, out var userId))
        {
            isLoading = false;
            return;
        }

        try
        {
            user = await Http.GetFromJsonAsync<User>($"api/users/{userId}/basic");
        }
        catch
        {
            user = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Logout()
    {
        // 1) Clear tokens
        await TokenSvc.RemoveAsync();

        // 2) Notify auth provider of anonymous user
        if (AuthStateProvider is JwtAuthStateProvider jwtProv)
        {
            jwtProv.NotifyUserLogout();
        }

        // 3) Redirect to login
        RedirectToLogin();
    }

    private void RedirectToLogin()
        => Nav.NavigateTo("/auth/login", true);

    private void ShowNotification()
    {
        // Without URL
        ToastService.ShowToast(ToastType.Success, "Success", "Operation completed!");

    }
    
    private void ShowNotification2()
    {

        // With URL navigation
        ToastService.ShowToast(
            ToastType.Info,
            "New Message",
            "You have a new message",
            url: "/messages"
        );
    }
}
